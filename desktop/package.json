{
  "name": "atlas-master-desktop",
  "version": "0.1.3+build.1",
  "description": "Локальный Атлас мастера для Windows 10 и 11",
  "author": "Atlas Master",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "pack:win": "npm run build && electron-builder --win dir --x64"
  },
  "dependencies": {
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ru.atlasmaster.desktop",
    "productName": "Атлас мастера",
    "artifactName": "AtlasMaster-0.1.3.1-${arch}-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "storage.cjs",
      "server.cjs",
      "icon.png",
      "icon.ico",
      "dist-renderer/**/*",
      "package.json",
      "preload.cjs"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "buildVersion": "0.1.3.1"
  },
  "atlasVersion": "0.1.3.1"
}
